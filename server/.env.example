# Railway auto-populates this when you add a Postgres addon — copy its
# value into your real .env (or Railway's own environment variables panel;
# don't commit a real .env file).
DATABASE_URL=postgres://user:password@localhost:5432/workout_tracker

# Set to "false" only for a local Postgres with SSL disabled. Railway's
# Postgres needs SSL, so leave this unset (or "true") in production.
PGSSL=false

# Generate a real random value for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string

PORT=4000

# The URL your deployed client will be served from, e.g. https://myapp.up.railway.app
# Leave unset (or "*") during local development.
CORS_ORIGIN=*
